<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dailyhub.catchup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/YOUR_USER/DailyHub/automation/catchup.sh</string>
  </array>
  <!-- At login, then every 15 minutes. launchd never starts a second copy while one is still running. -->
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/DailyHub/.locks/catchup.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/DailyHub/.locks/catchup.err</string>
</dict>
</plist>
